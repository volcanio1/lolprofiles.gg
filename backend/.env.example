# Riot API key. Required. Never commit a real key.
# Get one at https://developer.riotgames.com (development keys expire after 24h).
RIOT_API_KEY=RGAPI-your-key-here

# Data Dragon release that every champion, item and profile-icon asset is resolved
# against. REQUIRED, and deliberately has no default.
#
# Pin an EXACT release. "latest" is rejected: a moving alias would make a Riot patch
# change what the site renders with no deploy, and would let two requests seconds
# apart resolve assets against different releases.
#
# Current releases: https://ddragon.leagueoflegends.com/api/versions.json
DDRAGON_VERSION=16.17.1

# Port the API listens on. Optional, defaults to 3001.
PORT=3001

# How many recent matches to fetch and detail per lookup. Optional; unset = 100,
# which suits a PRODUCTION key. A DEVELOPMENT key allows only 100 requests per
# 2 minutes, so a cold-cache lookup at 100 exhausts the budget in one burst and
# every subsequent request 429s until the window clears. Set this to ~30 when
# running against a dev key.
# MATCH_HISTORY_COUNT=30

# Comma-separated list of EXACT origins allowed to call the API cross-origin,
# e.g. https://lolprofiles.gg,https://www.lolprofiles.gg
#
# Leave this UNSET for local development and for same-origin deployments. In
# development the Vite dev server proxies /api to this backend, so browser requests
# are same-origin and need no CORS headers. Only set it when the frontend is served
# from a genuinely different origin.
#
# There is deliberately no wildcard option: /api/lookup is unauthenticated and
# spends the shared Riot rate-limit budget on a cache miss, so allowing any origin
# would let any page on the internet consume it.
# CORS_ALLOWED_ORIGINS=
