# Riot API key. Required. Never commit a real key.
# Get one at https://developer.riotgames.com (development keys expire after 24h).
RIOT_API_KEY=RGAPI-your-key-here

# Port the API listens on. Optional, defaults to 3001.
PORT=3001

# Comma-separated list of EXACT origins allowed to call the API cross-origin,
# e.g. https://lolprofiles.gg,https://www.lolprofiles.gg
#
# Leave this UNSET for local development and for same-origin deployments. In
# development the Vite dev server proxies /api to this backend, so browser requests
# are same-origin and need no CORS headers. Only set it when the frontend is served
# from a genuinely different origin.
#
# There is deliberately no wildcard option: /api/lookup is unauthenticated and
# spends the shared Riot rate-limit budget on a cache miss, so allowing any origin
# would let any page on the internet consume it.
# CORS_ALLOWED_ORIGINS=
